# Nginx reverse proxy template -> the medai Node server on 127.0.0.1:3001.
# Install with deploy/05-setup-nginx.sh <domain> [www.domain ...], which substitutes
# __SERVER_NAMES__ below and provisions HTTPS via certbot. Works for any domain(s); not
# specific to one deployment.
#
# The Node server already serves the built frontend (dist/) and the /api/* routes
# itself in production, so nginx only needs to forward everything to it.

server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAMES__;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Twilio posts webhook payloads that can be larger than nginx's default body limit
    # for longer calls/recordings metadata.
    client_max_body_size 10m;
}
