[Unit]
Description=MedAI Suite (AI Healthcare Voice Intake) API and dashboard
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/medai
EnvironmentFile=/opt/medai/.env
ExecStart=__NODE_BIN__ server/server.js
Restart=on-failure
RestartSec=5
User=medai
Group=medai
# Hardening: the app only needs to read its own directory and talk to Postgres/the network.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
