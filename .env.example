# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=medai_suite

# Express server
PORT=3001

# Twilio telephony provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=http://localhost:3001/api/voice/twilio/incoming
TWILIO_TEST_TO_NUMBER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VOICE=alloy
OPENAI_SYSTEM_PROMPT=You are a calm clinic receptionist. Be warm, brief, and helpful.

# Authentication
# Generate a long random value for JWT_SECRET, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Used only to create the first administrator account when the users table is empty.
ADMIN_NAME=Clinic Administrator
ADMIN_EMAIL=admin@clinic.local
ADMIN_PASSWORD=Me12345ASDF
